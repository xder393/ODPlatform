          "editorMode": "code",
          "expr": "sum(rate(rag_advice_hits_total[5m])) / clamp_min(sum(rate(rag_advice_requests_total[5m])), 1e-9)",
          "legendFormat": "advice hit rate",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "API / WebSocket health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Uptime probe for the API scrape target; 1 means Prometheus can reach GET /metrics (the same process that serves /healthz and the inspection-events WebSocket).",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"odp-api\"}",
          "legendFormat": "api",
          "range": true,
          "refId": "A"
        }
      ]
    },
