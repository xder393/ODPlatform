# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
*.egg-info/
.eggs/

# ============================================================
# 虚拟环境
# ============================================================
venv/
env/
.venv/
ENV/

# ============================================================
# IDE / 编辑器
# ============================================================
.idea/
.vscode/
*.swp
*~

# ============================================================
# 操作系统
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# 测试 / 覆盖率
# ============================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ============================================================
# ODPlatform 专属(Monorepo 路径)
# ============================================================

# 数据集不进 git(走外部存储或 Git LFS)
data/raw/
data/train/
data/val/
data/test/
!data/README.md
!data/.gitkeep

# 模型权重不进 git
models/pretrained/*.pt
models/checkpoints/*.pt
models/checkpoints/*/
!models/pretrained/README.md
!models/checkpoints/README.md

# 训练运行结果(每次自动产生新目录)
runs/*
!runs/README.md

# 端私有日志(运行时产生,各机器不同)
apps/platform/logging/
*.log

# 临时文件
tmp/
temp/

# ============================================================
# 大文件 / 二进制
# ============================================================
*.pkl
*.h5
*.npz

# 工具元数据(reset/doctor 等元工具的审计日志,本地运行历史)
.odp-meta/

# Superpowers brainstorm visual companion session data
.superpowers/

# Isolated local worktrees
.worktrees/

# 运行时生成的配置(odp-gen-config / odp-transform 产出, 可随时重新生成)
apps/platform/configs/runtime/
apps/platform/configs/datasets/
